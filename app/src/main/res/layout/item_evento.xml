<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">



        <TextView
            android:id="@+id/minutaggio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="74'"
            android:textSize="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/card_evento"
            app:layout_constraintBottom_toBottomOf="@id/card_evento"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="16dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_evento"
            android:layout_width="200dp"
            android:layout_height="95dp"
            android:layout_marginStart="16dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/giorno_selezionato"
            app:layout_constraintStart_toEndOf="@id/minutaggio"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/nome_evento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="evento"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <ImageView
                    android:id="@+id/immagine_evento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/nome_giocatore"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:src="@drawable/assist" />

                <TextView
                    android:id="@+id/nome_giocatore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="cognome"
                    android:textSize="20dp"
                    android:layout_marginBottom="20dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageView
                    android:id="@+id/immagine_dettaglio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/nome_giocatore"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:src="@drawable/arrow_forward" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dettagli"
                    app:layout_constraintTop_toBottomOf="@id/nome_giocatore"
                    app:layout_constraintStart_toStartOf="@id/nome_giocatore"
                    app:layout_constraintEnd_toEndOf="@id/nome_giocatore"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


        </com.google.android.material.card.MaterialCardView>

    <ImageButton
        android:id="@+id/modificaEvento_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@color/transparent"
        android:src="@drawable/edit"
        app:layout_constraintStart_toEndOf="@id/card_evento"
        app:layout_constraintTop_toTopOf="@id/card_evento"/>

    <ImageButton
        android:id="@+id/eliminaEvento_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@color/transparent"
        android:src="@drawable/delete"
        app:layout_constraintStart_toEndOf="@id/card_evento"
        app:layout_constraintBottom_toBottomOf="@id/card_evento"/>

</androidx.constraintlayout.widget.ConstraintLayout>