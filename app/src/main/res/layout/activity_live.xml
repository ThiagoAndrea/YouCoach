<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/squadra_casa_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Squadra casa"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/risultato_casa"
        app:layout_constraintTop_toTopOf="parent"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/trattino"
        android:layout_marginEnd="24dp"/>

    <TextView
        android:id="@+id/risultato_casa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="46sp"
        app:layout_constraintEnd_toStartOf="@id/trattino"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"/>

    <TextView
        android:id="@+id/trattino"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textSize="46sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/risultato_trasferta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="46sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/trattino"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/squadra_ospite_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Squadra ospite"
        android:textSize="20sp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/risultato_trasferta"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@+id/trattino"/>

    <TextView
        android:id="@+id/minutaggio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/trattino" />

    <ImageButton
        android:id="@+id/btn_corner_casa"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/corner"
        app:layout_constraintEnd_toStartOf="@+id/minutaggio"
        app:layout_constraintTop_toBottomOf="@id/squadra_casa_text" />

    <ImageButton
        android:id="@+id/btn_corner_ospite"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/corner"
        app:layout_constraintStart_toEndOf="@+id/minutaggio"
        app:layout_constraintTop_toBottomOf="@id/squadra_ospite_text" />

    <ImageButton
        android:id="@+id/btn_tiri_ospite"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/tiro"
        app:layout_constraintStart_toEndOf="@+id/btn_corner_ospite"
        app:layout_constraintTop_toBottomOf="@id/squadra_ospite_text" />

    <ImageButton
        android:id="@+id/btn_tiri_casa"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/tiro"
        app:layout_constraintEnd_toStartOf="@+id/btn_corner_casa"
        app:layout_constraintTop_toBottomOf="@id/squadra_casa_text" />

    <ImageButton
        android:id="@+id/btn_gol_ospite"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/pallone"
        app:layout_constraintStart_toEndOf="@+id/btn_tiri_ospite"
        app:layout_constraintTop_toBottomOf="@id/squadra_ospite_text" />

    <ImageButton
        android:id="@+id/btn_gol_casa"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/pallone"
        app:layout_constraintEnd_toStartOf="@+id/btn_tiri_casa"
        app:layout_constraintTop_toBottomOf="@id/squadra_casa_text" />

    <TextView
        android:id="@+id/tempo_di_gioco"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1T"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@+id/minutaggio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView per visualizzare le righe della formazione (senza header del ruolo) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFormazione"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/giorno_selezionato"
        app:layout_constraintTop_toBottomOf="@+id/tempo_di_gioco"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/textPanchina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Panchina:"
        android:textSize="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recyclerFormazione" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPanchina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/textPanchina"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_start_match"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/fischietto"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
