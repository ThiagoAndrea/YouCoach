<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Box Sinistra -->
    <FrameLayout
        android:id="@+id/box_sinistra"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/minutaggio_cerchio"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_evento_sinistra"
            android:layout_width="150dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/green_base">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/immagine_evento_sx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/assist"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/nome_giocatore_sx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="cognome"
                    android:textSize="14dp"
                    android:textColor="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="@id/immagine_evento_sx"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/dettaglio_evento_sx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dettagli"
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    app:layout_constraintTop_toBottomOf="@id/nome_giocatore_sx"
                    app:layout_constraintStart_toStartOf="@id/nome_giocatore_sx"
                    app:layout_constraintEnd_toEndOf="@id/nome_giocatore_sx" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <ImageButton
        android:id="@+id/modifica_evento_sx"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/edit"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/minutaggio_cerchio"
        app:layout_constraintTop_toTopOf="@id/minutaggio_cerchio"
        app:layout_constraintBottom_toBottomOf="@id/minutaggio_cerchio"
        android:layout_marginStart="16dp" />

    <ImageButton
        android:id="@+id/elimina_evento_sx"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/delete"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/minutaggio_cerchio"
        app:layout_constraintTop_toTopOf="@id/minutaggio_cerchio"
        app:layout_constraintBottom_toBottomOf="@id/minutaggio_cerchio"
        android:layout_marginStart="16dp" />

    <!-- Minutaggio centrale -->
    <TextView
        android:id="@+id/minutaggio_cerchio"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="8dp"
        android:gravity="center"
        android:text="45'"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/circle_backkground_centrocampista"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Box Destra -->
    <FrameLayout
        android:id="@+id/box_destra"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/minutaggio_cerchio"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_evento_destra"
            android:layout_width="150dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/opposite_base">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/immagine_evento_dx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/assist"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/nome_giocatore_dx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="cognome"
                    android:textSize="14dp"
                    android:textColor="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="@id/immagine_evento_dx"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/dettaglio_evento_dx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dettagli"
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    app:layout_constraintTop_toBottomOf="@id/nome_giocatore_dx"
                    app:layout_constraintStart_toStartOf="@id/nome_giocatore_dx"
                    app:layout_constraintEnd_toEndOf="@id/nome_giocatore_dx" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <ImageButton
        android:id="@+id/modifica_evento_dx"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/edit"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/minutaggio_cerchio"
        app:layout_constraintTop_toTopOf="@id/minutaggio_cerchio"
        app:layout_constraintBottom_toBottomOf="@id/minutaggio_cerchio"
        android:layout_marginEnd="16dp" />

    <ImageButton
        android:id="@+id/elimina_evento_dx"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/delete"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/minutaggio_cerchio"
        app:layout_constraintTop_toTopOf="@id/minutaggio_cerchio"
        app:layout_constraintBottom_toBottomOf="@id/minutaggio_cerchio"
        android:layout_marginEnd="16dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
