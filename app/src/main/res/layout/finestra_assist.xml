<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp">

    <!-- Titolo -->
    <TextView
        android:id="@+id/textSelezionaAssist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Assist"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Spinner per la selezione dell'assist -->
    <Spinner
        android:id="@+id/spinnerAssist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/textSelezionaAssist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Bottone per confermare la selezione dell'assist -->
    <Button
        android:id="@+id/btnConfermaAssist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Conferma"
        app:layout_constraintTop_toBottomOf="@id/spinnerAssist"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"/>

    <!-- Bottone per selezionare nessun assist -->
    <Button
        android:id="@+id/btnNessunAssist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nessun assist"
        app:layout_constraintTop_toBottomOf="@id/spinnerAssist"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"/>

    <!-- Bottone per chiudere la finestra -->
    <ImageButton
        android:id="@+id/btnChiudiAssist"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="@color/transparent"
        android:src="@drawable/croce"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
