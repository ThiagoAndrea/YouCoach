<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ImageView
        android:id="@+id/logo_squadra"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/ultima_partita_text"
        android:src="@drawable/logo"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp" />


    <!-- Bottom Navigation View in basso -->
    <TextView
        android:id="@+id/nome_squadra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bedizzole U16"
        android:textSize="36dp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/ultima_partita_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/logo_squadra" />

    <TextView
        android:id="@+id/ultima_partita_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_squadra"
        android:layout_marginTop="16dp"
        android:text="Ultima partita"
        android:textSize="24dp"
        android:layout_marginStart="16dp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView

        android:id="@+id/card_ultima_partita"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintTop_toBottomOf="@+id/ultima_partita_text"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:cardBackgroundColor="@color/background_last_match"
        app:cardCornerRadius="8dp">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <TextView
                    android:id="@+id/risultato_ultima_partita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bedizzole 3 - 2 Roncadelle"
                    android:textSize="24dp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />

            <Button
                android:id="@+id/btn_vai_a_partita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/background_button_grey"
                android:text="DETTAGLI"
                android:textColor="@color/black"
                android:textSize="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/risultato_ultima_partita"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/pallone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/prossime_partite_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_ultima_partita"
        android:layout_marginTop="16dp"
        android:text="Prossime partite"
        android:textSize="24dp"
        android:layout_marginStart="16dp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_prossime_partite"
        android:layout_width="120dp"
        android:layout_height="100dp"
        app:layout_constraintTop_toBottomOf="@+id/prossime_partite_text"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:cardBackgroundColor="@color/background_last_match"
        app:cardCornerRadius="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <ImageView
                android:id="@+id/logo_trasferta"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/aereo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valtenesi"
                android:layout_marginTop="16dp"
                android:textSize="18dp"
                app:layout_constraintTop_toBottomOf="@id/logo_trasferta"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />





        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>




    <TextView
        android:id="@+id/statistiche_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_prossime_partite"
        android:layout_marginTop="16dp"
        android:text="Statistiche"
        android:textSize="24dp"
        android:layout_marginStart="16dp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_vedi_statistiche"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@+id/statistiche_text"
        app:layout_constraintTop_toBottomOf="@+id/card_ultima_partita"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/transparent"
        android:textColor="@color/black"
        android:text="Vedi tutte"
        android:textAllCaps="true"
        android:textSize="16dp" />


    <androidx.cardview.widget.CardView
        android:layout_width="170dp"
        android:layout_height="200dp"
        app:layout_constraintTop_toBottomOf="@+id/statistiche_text"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:cardBackgroundColor="@color/background_training_card"
        app:cardCornerRadius="8dp">
        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <TextView
                android:id="@+id/num_allenamenti"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                android:textSize="64dp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/allenamenti_fatto_text"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:id="@+id/allenamenti_fatto_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Allenamenti fatti"
                android:textSize="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/num_allenamenti"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>


        
        
        
    </androidx.cardview.widget.CardView>









    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="?android:attr/windowBackground"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        style="@style/BottomNavigationViewStyle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
