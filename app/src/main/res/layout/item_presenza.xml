<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:strokeColor="@color/black"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Nome e cognome del giocatore -->
    <TextView
        android:id="@+id/txt_giocatore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nome Cognome"
        android:textSize="16sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageButton
        android:id="@+id/btn_presenza"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/check"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_assenza"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_assenza"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/croce"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_ritardo"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_ritardo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ritardo"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_infortunio"
        app:layout_constraintTop_toTopOf="parent" />



        <ImageButton
        android:id="@+id/btn_infortunio"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/infortunio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />




    

    </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>