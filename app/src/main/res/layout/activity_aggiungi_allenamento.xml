<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@color/background_grey"
        android:src="@drawable/arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/editTextData"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Data"
        android:inputType="date"
        app:layout_constraintTop_toBottomOf="@id/back_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/editTextOrarioInizio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Orario di inizio"
        android:inputType="time"
        app:layout_constraintTop_toBottomOf="@id/editTextData"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/editTextOrarioFine"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/editTextOrarioFine"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Orario di fine"
        android:inputType="time"
        app:layout_constraintTop_toBottomOf="@id/editTextData"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toEndOf="@+id/editTextOrarioInizio"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/text_obiettivi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Obiettivi:"
        android:textSize="20sp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@+id/editTextOrarioFine"
        app:layout_constraintStart_toStartOf="parent"
        />




    <!-- Campo per la selezione multipla degli obiettivi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewObiettivi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text_obiettivi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:nestedScrollingEnabled="false" />

    <!-- Pulsante per aggiungere/modificare obiettivi -->
    <Button
        android:id="@+id/buttonAggiungiObiettivo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Aggiungi/Modifica Obiettivo"
        app:layout_constraintTop_toBottomOf="@id/recyclerViewObiettivi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp" />


    <Button
        android:id="@+id/buttonAggiungiAllenamento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Aggiungi Allenamento"
        app:layout_constraintTop_toBottomOf="@id/buttonAggiungiObiettivo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="?android:attr/windowBackground"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        style="@style/BottomNavigationViewStyle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
