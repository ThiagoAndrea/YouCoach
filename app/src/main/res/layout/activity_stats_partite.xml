<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@color/transparent"
        android:src="@drawable/arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tvTitoloAllenamento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Statistiche Partite"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/spinnerMese"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:singleSelection="false"
        app:selectionRequired="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip1"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Campionato"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip2"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coppa"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip3"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amichevole"
            android:checkable="true" />

        <!-- Add more chips as needed -->

    </com.google.android.material.chip.ChipGroup>


    <TextView
        android:id="@+id/textMese"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mese"
        android:textSize="16sp"
        app:layout_constraintBaseline_toBaselineOf="@id/spinnerMese"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp" />

    <Spinner
        android:id="@+id/spinnerMese"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitoloAllenamento"
        app:layout_constraintStart_toEndOf="@id/textMese"
        android:layout_marginEnd="8dp"/>

    <TextView
        android:id="@+id/textRisultati"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Risultati"
        android:textSize="20sp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@+id/pieChartRisultati"
        app:layout_constraintEnd_toEndOf="@+id/pieChartRisultati"
        app:layout_constraintTop_toBottomOf="@+id/chipGroup"/>


    <com.github.mikephil.charting.charts.PieChart
        android:id="@+id/pieChartRisultati"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/textRisultati"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/textGol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gol"
        android:textSize="20sp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@+id/pieChartGol"
        app:layout_constraintEnd_toEndOf="@+id/pieChartGol"
        app:layout_constraintTop_toBottomOf="@+id/chipGroup"/>


    <com.github.mikephil.charting.charts.PieChart
        android:id="@+id/pieChartGol"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/textRisultati"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />



    <TextView
        android:id="@+id/textTiri"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tiri"
        android:textSize="20sp"
        android:layout_marginTop="48dp"
        app:layout_constraintStart_toStartOf="@+id/pieChartTiri"
        app:layout_constraintEnd_toEndOf="@+id/pieChartTiri"
        app:layout_constraintTop_toBottomOf="@+id/pieChartRisultati" />


    <com.github.mikephil.charting.charts.PieChart
        android:id="@+id/pieChartTiri"
        android:layout_width="80dp"
        android:layout_height="150dp"
        app:layout_constraintTop_toBottomOf="@id/textTiri"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp" />


    <TextView
        android:id="@+id/textFalli"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Falli"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@+id/pieChartFalli"
        app:layout_constraintStart_toStartOf="@+id/pieChartFalli"
        app:layout_constraintTop_toBottomOf="@+id/pieChartRisultati" />

    <com.github.mikephil.charting.charts.PieChart
        android:id="@+id/pieChartFalli"
        android:layout_width="80dp"
        android:layout_height="150dp"
        app:layout_constraintTop_toBottomOf="@id/textTiri"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textAngoli"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Angoli"
        android:textSize="20sp"
        android:layout_marginTop="48dp"
        app:layout_constraintStart_toStartOf="@+id/pieChartAngoli"
        app:layout_constraintEnd_toEndOf="@+id/pieChartAngoli"
        app:layout_constraintTop_toBottomOf="@+id/pieChartRisultati" />


    <com.github.mikephil.charting.charts.PieChart
        android:id="@+id/pieChartAngoli"
        android:layout_width="80dp"
        android:layout_height="150dp"
        app:layout_constraintTop_toBottomOf="@id/textTiri"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp" />





    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="?android:attr/windowBackground"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        style="@style/BottomNavigationViewStyle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>


